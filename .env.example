# ===== EasyVoice 环境配置模板 =====
#
# 用法：把本文件复制成 `.env`，按需取消注释并填写，改完要重启服务。
# 位置：放在项目根目录即可（也支持 packages/backend/.env）。
#
# 说明：下面所有项都是可选的。完全不做任何配置，也能用微软 Edge-TTS 免费合成，
#       只是网页上的「AI 推荐」按钮用不了。

# ---------- 服务端口 ----------
# 默认 3000；如果被占用（比如同时开了别的东西）改成别的
# PORT=3000

# ---------- AI 智能推荐配音（可选）----------
# 不填也能正常合成，只是无法使用「AI 推荐」自动分配角色音色。
# 任何 OpenAI 兼容接口都行（DeepSeek、OpenAI、OpenRouter、本地 Ollama…）
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=sk-在这里填你的密钥
# MODEL_NAME=deepseek-chat

# ---------- 合成相关（一般不用改）----------
# 单次「同步生成」接口的文本上限，超过会自动切换到流式接口，默认 200
# DIRECT_GEN_LIMIT=200

# 限制单次输入的文本总长度，0 = 不限制
# LIMIT_TEXT_LENGTH=0
# LIMIT_TEXT_LENGTH_ERROR_MESSAGE=文本太长了，请分段生成

# Edge-TTS 段内并发数（1~10），默认 3。调大更快但更容易被微软限流
# EDGE_API_LIMIT=3

# 单个分段合成失败后的重试间隔基数（毫秒），默认 1000。
# 微软免费接口会短时限流（WebSocket 1006 断连），间隔太小重试基本没用
# EDGE_RETRY_BASE_DELAY_MS=1000

# ---------- 整本小说「按章节批量合成」专用（一般不用改）----------
# 一章内同时合成几段，默认 2。长跑时调小更稳（1 最稳最慢）
# CHAPTER_SEGMENT_CONCURRENCY=2
# 整章失败后重试几次，默认 2
# CHAPTER_MAX_ATTEMPTS=2
# 整章重试前等待毫秒，默认 8000
# CHAPTER_RETRY_DELAY_MS=8000
# 每章之间的间隔毫秒，默认 500
# CHAPTER_INTERVAL_MS=500

# ffmpeg 拼接单章音频的超时毫秒，超时判失败（避免任务卡死），默认 180000
# CONCAT_TIMEOUT_MS=180000

# ---------- 接口限流与安全（默认关闭）----------
# USE_LIMIT=true
# RATE_LIMIT_WINDOW=1
# RATE_LIMIT=10
# USE_HELMET=true

# ---------- 其他 TTS 引擎（可选）----------
# REGISTER_OPENAI_TTS=false
# REGISTER_KOKORO=false
# TTS_KOKORO_URL=http://localhost:8880/v1
